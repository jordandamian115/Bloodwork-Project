# Local inference (default). Keep PHI on-box; do not send lab PDFs to public APIs.
OLLAMA_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
CHROMA_DIR=./chroma_db

# local | comprehend_medical
PHI_BACKEND=local

# Optional AWS (HIPAA-eligible services require a BAA + private networking in production)
AWS_REGION=us-east-1
# COMPREHEND_MEDICAL_MIN_SCORE=0.5
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
# BEDROCK_APPLY_GUARDRAIL=false
